{
  "db_name": "PostgreSQL",
  "query": "\n        select\n            c.org_id,\n            c.mailbox_id,\n            m.email       as mailbox_email,\n            m.daily_cap,\n            l.email       as lead_email,\n            l.unsubscribe_token,\n            l.first_name,\n            l.last_name,\n            l.company,\n            l.custom,\n            cl.current_step,\n            cl.thread_id,\n            s.id          as step_id,\n            s.position,\n            s.subject,\n            s.body\n        from campaign_leads cl\n        join campaigns c on c.id = cl.campaign_id\n        join mailboxes m on m.id = c.mailbox_id\n        join leads l on l.id = cl.lead_id\n        join sequence_steps s\n          on s.sequence_id = c.sequence_id and s.position = cl.current_step\n        where cl.id = $1\n          and cl.status = 'pending'\n          and c.status = 'running'\n          and m.status = 'active'\n          and not exists (\n              select 1 from suppressions sup\n              where sup.org_id = c.org_id and lower(sup.email) = lower(l.email)\n          )\n        ",
