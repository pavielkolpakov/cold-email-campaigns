  "query": "\n        select s.id, s.position, s.delay_days, s.subject, s.body\n        from sequence_steps s\n        join sequences q on q.id = s.sequence_id\n        where s.sequence_id = $1 and q.org_id = $2\n        order by s.position\n        ",
