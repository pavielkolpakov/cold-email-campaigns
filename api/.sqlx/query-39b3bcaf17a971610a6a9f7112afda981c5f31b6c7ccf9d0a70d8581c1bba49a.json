{
  "db_name": "PostgreSQL",
  "query": "\n        select\n            m.id,\n            m.email,\n            m.status,\n            m.daily_cap,\n            (\n                select count(*)\n                from messages msg\n                join campaign_leads cl on cl.id = msg.campaign_lead_id\n                join campaigns c on c.id = cl.campaign_id\n                where c.mailbox_id = m.id and msg.sent_at >= date_trunc('day', now())\n            ) as \"sent_today!\"\n        from mailboxes m\n        where m.org_id = $1\n        order by m.email\n        ",
