{
  "db_name": "PostgreSQL",
  "query": "\n        select cl.id, l.email\n        from campaign_leads cl\n        join campaigns c on c.id = cl.campaign_id\n        join leads l on l.id = cl.lead_id\n        where cl.thread_id = $1\n          and c.org_id = $2\n          and c.mailbox_id = $3\n          and cl.status not in ('replied', 'bounced')\n        ",
