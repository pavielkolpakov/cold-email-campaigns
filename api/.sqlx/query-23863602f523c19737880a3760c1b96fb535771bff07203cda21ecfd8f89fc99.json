{
  "db_name": "PostgreSQL",
  "query": "\n        update mailboxes\n        set last_synced_at = now()\n        where id in (\n            select id from mailboxes\n            where status = 'active'\n              and (last_synced_at is null or last_synced_at < now() - $1::interval)\n            for update skip locked\n        )\n        returning org_id, id\n        ",
